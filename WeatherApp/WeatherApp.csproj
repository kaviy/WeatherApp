<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeatherApp</RootNamespace>
    <UserSecretsId>c1f2a9b4-5d6e-4f7a-8b9c-0d1e2f3a4b5c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ensure dates.txt and dev-time weather-data are copied/available next to the build output -->
    <None Update="dates.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
